---
import { getCollection } from "astro:content";
import PageHeader from "../../components/PageHeader.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isPublished } from "../../utils/content";

const projects = (await getCollection("projects", isPublished)).sort(
  (left, right) => Number(right.data.featured) - Number(left.data.featured) ||
    (right.data.year ?? 0) - (left.data.year ?? 0) ||
    left.data.title.localeCompare(right.data.title),
);
---

<BaseLayout title="Projects" description="Public products, software, games, and applied AI projects by Che (Percy) Liu.">
  <PageHeader
    eyebrow="Public builds"
    title="Projects"
    description="Projects with links that can be inspected today. Team work names my actual role; a public repository is not treated as a license claim."
    count={projects.length}
  />
  <section class="shell section-space" aria-label="Public projects">
    {
      projects.length > 0 ? (
        <div class="project-index project-index--archive">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      ) : (
        <div class="empty-state"><h2>No public projects yet</h2><p>Projects appear only after their links and attribution are verified.</p></div>
      )
    }
  </section>
</BaseLayout>
